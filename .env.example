# Copy to .env and fill in for a production-shaped local run.
# Every value below has a working offline default (see resolveai/config.py) --
# you only need this file to switch a provider on.

# --- LLM ---
RESOLVEAI_LLM_PROVIDER=fake          # fake | anthropic
RESOLVEAI_ANTHROPIC_MODEL=claude-sonnet-4-5
RESOLVEAI_ANTHROPIC_API_KEY=

# --- Embeddings ---
RESOLVEAI_EMBEDDING_PROVIDER=fake    # fake | azure_openai
RESOLVEAI_AZURE_OPENAI_ENDPOINT=
RESOLVEAI_AZURE_OPENAI_API_KEY=
RESOLVEAI_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Vector store ---
RESOLVEAI_VECTOR_STORE=memory        # memory | pgvector
RESOLVEAI_DATABASE_URL=postgresql://resolveai:resolveai@localhost:5432/resolveai

# --- Policy ---
RESOLVEAI_CONFIDENCE_THRESHOLD=0.72
RESOLVEAI_RETRIEVAL_TOP_K=5
